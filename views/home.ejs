<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rutledge — Home</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="page">
    <div class="form-container">
      <div class="brand">Rutledge</div>
      <h2>Welcome, <%= name %></h2>
      <p style="text-align:center; margin-bottom: 20px;">You're signed in.</p>
      <button id="logoutBtn" class="submit-btn">Sign out</button>
    </div>
  </div>

  <script>
    // /auth/logout is POST-only (that's the more correct way to do a
    // logout — a plain link would make it a GET, which means anything
    // that ever pre-fetches links, like a browser or a scanner, could
    // accidentally log someone out). So this is a button with a click
    // handler instead of an <a href="...">.
    document.getElementById("logoutBtn").addEventListener("click", async () => {
      await fetch("/auth/logout", { method: "POST" });
      window.location.href = "/auth/login";
    });
  </script>
</body>
</html>
